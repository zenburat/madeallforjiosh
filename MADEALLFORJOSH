RunService.RenderStepped:Connect(function()
    local on = Settings:Get("ESP")
    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
        local e = GetESP(p)
        local char = p.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")

        local hide = (not on) or (not char) or (not hum) or (not root) or (not head)
            or hum.Health <= 0
            or (Settings:Get("TeamCheck") and p.Team == player.Team and p.Team ~= nil)

        if hide then
            e.box.Visible = false; e.name.Visible = false
            e.hp.Visible = false; e.tracer.Visible = false
            continue
        end

        local hScr, hOn = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
        local fScr = camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))

        if not hOn then
            e.box.Visible = false; e.name.Visible = false
            e.hp.Visible = false; e.tracer.Visible = false
            continue
        end

        local bH = math.abs(hScr.Y - fScr.Y)
        local bW = bH * 0.55

        e.box.Visible  = true
        e.box.Size     = UDim2.fromOffset(bW, bH)
        e.box.Position = UDim2.fromOffset(hScr.X - bW/2, hScr.Y)

        e.name.Visible  = true
        e.name.Text     = p.DisplayName
        e.name.Position = UDim2.fromOffset(hScr.X, hScr.Y - 2)

        e.hp.Visible  = true
        e.hp.Text     = math.floor(hum.Health) .. " HP"
        e.hp.Position = UDim2.fromOffset(hScr.X, fScr.Y + 2)

        -- Tracer line — FIXED: math.atan (not math.atan2)
        local fromX = camera.ViewportSize.X / 2
        local fromY = camera.ViewportSize.Y
        local dx = hScr.X - fromX
        local dy = hScr.Y - fromY
        local len = math.sqrt(dx*dx + dy*dy)
        local angle = math.deg(math.atan(dy, dx))

        e.tracer.Visible  = true
        e.tracer.Size     = UDim2.fromOffset(len, 1)
        e.tracer.Position = UDim2.fromOffset((fromX + hScr.X)/2, (fromY + hScr.Y)/2)
        e.tracer.Rotation = angle
    end
end)

