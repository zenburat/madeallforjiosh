local function New(class, props, children)
    local o = Instance.new(class)
    for k,v in pairs(props) do o[k]=v end
    for _,c in ipairs(children or {}) do c.Parent=o end
    return o
end
local function Tween(o,t,p,s)
    TweenService:Create(o,TweenInfo.new(t,s or Enum.EasingStyle.Quint,Enum.EasingDirection.Out),p):Play()
end

--------------------------------------------------------------------
-- DRAGGABLE (mobile-safe) — defined early so key card can use it
--------------------------------------------------------------------
local function MakeDraggable(frame, handle)
    local dragging = false
    local dragStart, startPos
    local activeTouch = nil

    local function beginDrag(input)
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        if input.UserInputType == Enum.UserInputType.Touch then
            activeTouch = input
        end
    end

    local function endDrag()
        dragging = false
        activeTouch = nil
    end

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            beginDrag(input)
        end
    end)

    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            endDrag()
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            if input.UserInputType == Enum.UserInputType.Touch
            and activeTouch and input ~= activeTouch then
                return
            end
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.TouchEnded:Connect(function()
        if dragging then endDrag() end
    end)
end

