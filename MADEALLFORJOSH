-- SILENT AIM HOOK (only runs in executor)
--------------------------------------------------------------------
if IS_EXPLOIT then
    local headIndex = 1
    local function GetAllHeads()
        local heads = {}
        for _,p in ipairs(Players:GetPlayers()) do
            if p == player then continue end
            if Settings:Get("TeamCheck") and p.Team == player.Team and p.Team ~= nil then continue end
            local char = p.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            local bone = char and char:FindFirstChild(aimBone)
            if char and hum and hum.Health > 0 and bone then
                if not Settings:Get("WallCheck") or HasLOS(camera.CFrame.Position, bone.Position) then
                    table.insert(heads, bone)
                end
            end
        end
        return heads
    end

    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if Settings:Get("SilentAim") and (method == "FireServer" or method == "InvokeServer") then
            local heads = GetAllHeads()
            if #heads > 0 then
                local target = heads[(headIndex - 1) % #heads + 1]
                headIndex = headIndex + 1
                local args = {...}
                for i, v in ipairs(args) do
                    if typeof(v) == "Vector3" then
                        args[i] = target.Position
                    elseif typeof(v) == "CFrame" then
                        args[i] = CFrame.new(camera.CFrame.Position, target.Position)
                    end
                end
                return oldNamecall(self, table.unpack(args))
            end
        end
        return oldNamecall(self, ...)
    end)
end

