local function Shake()
    local original = keyCard.Position
    local offsets = {12, -12, 10, -10, 6, -6, 0}
    for _, off in ipairs(offsets) do
        TweenService:Create(keyCard, TweenInfo.new(0.05), {
            Position = UDim2.new(original.X.Scale, original.X.Offset + off, original.Y.Scale, original.Y.Offset)
        }):Play()
        task.wait(0.05)
    end
end

local wrongTries = 0
local locked = false
local unlocked = false

local function TryUnlock()
    if locked or unlocked then return end
    local input = keyBox.Text:gsub("^%s+", ""):gsub("%s+$", ""):upper()
    local expected = VALID_KEY:upper()

    if input == expected then
        unlocked = true
        keyStatus.Text = "✅ Access granted"
        keyStatus.TextColor3 = Color3.fromRGB(80, 220, 120)
        TweenService:Create(keyBlur, TweenInfo.new(0.4), { Size = 0 }):Play()
        task.delay(0.5, function() if keyBlur then keyBlur:Destroy() end end)
        task.wait(0.5)
        keyGui:Destroy()
        _G.__NoxinUnlocked = true
    else
        wrongTries = wrongTries + 1
        keyStatus.Text = "❌ Invalid key ("..wrongTries.."/3)"
        keyStatus.TextColor3 = Color3.fromRGB(240, 80, 80)
        Shake()
        keyBox.Text = ""
        if wrongTries >= 3 then
            locked = true
            keyStatus.Text = "🚫 Too many attempts. Wait 5s..."
            keyBox.TextEditable = false
            task.wait(5)
            wrongTries = 0
            locked = false
            keyBox.TextEditable = true
            keyStatus.Text = ""
        end
    end
end

unlockBtn.MouseButton1Click:Connect(TryUnlock)
keyBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then TryUnlock() end
end)

