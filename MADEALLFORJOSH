local function EnableFly()
    local char=player.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    local hum =char and char:FindFirstChildOfClass("Humanoid")
    if not char or not root or not hum then return end
    hum.PlatformStand=true
    flyBV=Instance.new("BodyVelocity"); flyBV.MaxForce=Vector3.new(1e5,1e5,1e5); flyBV.Velocity=Vector3.zero; flyBV.Parent=root
    flyBAV=Instance.new("BodyAngularVelocity"); flyBAV.MaxTorque=Vector3.new(1e5,1e5,1e5); flyBAV.AngularVelocity=Vector3.zero; flyBAV.Parent=root
